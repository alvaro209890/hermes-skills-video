[
  {
    "start": 2.526315789473684,
    "end": 5.526315789473684,
    "text": "SEIS OLHOS ABERTOS, EU ENXERGO O QUE NINGUÉM VÊ",
    "impact": "SEIS OLHOS"
  },
  {
    "start": 5.684210526315789,
    "end": 8.68421052631579,
    "text": "O INFINITO NA MINHA FRENTE: CÊ CHEGA, MAS NÃO ME ALCANÇA",
    "impact": "INFINITO"
  },
  {
    "start": 8.842105263157894,
    "end": 11.842105263157894,
    "text": "ROXO VAZIO NA PALMA, MAIS E MENOS COLIDEM",
    "impact": "ROXO VAZIO"
  },
  {
    "start": 12.0,
    "end": 15.0,
    "text": "E O SILÊNCIO DEPOIS DO ESTOURO É A ÚNICA HERANÇA",
    "impact": "SILÊNCIO"
  },
  {
    "start": 15.157894736842104,
    "end": 18.157894736842103,
    "text": "EU SOU O MAIS FORTE. NÃO É VAIDADE, É SENTENÇA",
    "impact": "MAIS FORTE"
  },
  {
    "start": 18.31578947368421,
    "end": 21.31578947368421,
    "text": "SOZINHO NO TOPO, PORQUE O TOPO NÃO TEM COMPANHIA",
    "impact": "SOZINHO NO TOPO"
  },
  {
    "start": 21.473684210526315,
    "end": 24.473684210526315,
    "text": "GOJO SATORU: O LIMITE VIROU LEMBRANÇA",
    "impact": "GOJO SATORU"
  },
  {
    "start": 24.63157894736842,
    "end": 27.63157894736842,
